      <aliases enabled='yes' />
      <column caption='Month' datatype='string' name='[Calculation_0357393051754496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// simply grabs the month from invoice date&#13;&#10;DATENAME(&apos;month&apos;, [InvoiceDate])' />
      </column>
      <column caption='Order Year' datatype='integer' name='[Calculation_0357393053184001]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([InvoiceDate])' />
      </column>
      <column caption='Month Year' datatype='string' name='[Calculation_0357393053958146]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [InvoiceDate]) + &quot; &quot;  + STR(YEAR([InvoiceDate]))&#13;&#10;&#13;&#10;// Concatenation of strings - or letters&#13;&#10;// joining text type output of datenmae&#13;&#10;// with number type output of year&#13;&#10;// by converting year output to STRING - text data type&#13;&#10;// using + to join them all' />
      </column>
      <column caption='Distinct Customers' datatype='integer' name='[Calculation_0357393055780867]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([CustomerID])' />
      </column>
      <column caption='Hour of Purchase' datatype='integer' name='[Calculation_0357393057046532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [InvoiceDate])' />
      </column>
